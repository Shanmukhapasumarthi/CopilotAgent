# Copy this file to .env and fill in local secrets.
# Never commit .env.

# Required for live LLM calls. Unit tests do not need a real key.
GROQ_API_KEY=

# Fast default for the agent loop. Override if Groq lists a different ID.
LLM_MODEL=
LLM_TEMPERATURE=0.2

# Bounded agent loop.
MAX_ITERATIONS=8

# Virtual environment sandbox (generated code runs in isolated venv).
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MEMORY=256m
SANDBOX_CPUS=0.5
SANDBOX_PIDS=64

# Logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Input bounds (prompt-injection / resource hardening)
MAX_REQUEST_CHARS=8000
MAX_SOURCE_CHARS=20000
GRAPH_RECURSION_LIMIT=48

# LangSmith observability (optional - set to "true" to enable)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=codepilot-agent
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
